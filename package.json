{
  "name": "wedding-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Đám cưới 3D online – khách mời tạo nhân vật, đi lại giữa các khu, chat, nhảy và gửi lời chúc",
  "scripts": {
    "dev": "concurrently -k -n web,ws -c magenta,cyan \"vite --host\" \"node server/index.js\"",
    "dev:web": "vite --host",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
