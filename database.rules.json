{
  "rules": {
    ".read": false,
    ".write": false,
    "wedding": {
      ".read": true,
      "presence": {
        "$id": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isBoolean()"
        }
      },
      "peers": {
        "$id": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 20)"
        }
      },
      "st": {
        "$id": {
          ".write": true,
          ".validate": "!newData.exists() || newData.hasChildren(['p', 'r', 'a'])"
        }
      },
      "events": {
        "$e": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.child('t').isString() && newData.child('t').val().length <= 12 && (!newData.child('text').exists() || newData.child('text').val().length <= 120) && (!newData.child('prize').exists() || newData.child('prize').val().length <= 80))"
        }
      },
      "wishes": {
        "$w": {
          ".write": "!data.exists()",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 300 && newData.child('name').isString() && newData.child('name').val().length <= 20"
        }
      },
      "rsvp": {
        "$uid": {
          ".write": true,
          ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('go').isBoolean() && newData.child('n').isNumber() && newData.child('n').val() >= 0 && newData.child('n').val() <= 10 && newData.child('at').isNumber() && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 200)) && (!newData.child('side').exists() || newData.child('side').val() === '' || newData.child('side').val() === 'trai' || newData.child('side').val() === 'gai') && (!newData.child('to').exists() || (newData.child('to').isString() && newData.child('to').val().length <= 40))"
        }
      },
      "likes": {
        "$wish": {
          "$uid": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          }
        }
      },
      "boards": {
        "$board": {
          ".validate": "$board === 'quiz' || $board === 'hunt'",
          "$uid": {
            ".write": true,
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('at').isNumber() && (!newData.child('score').exists() || (newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 20))"
          }
        }
      },
      "voice": {
        "$id": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.child('mic').isBoolean() && newData.child('stage').isBoolean())"
        }
      },
      "rtc": {
        "$to": {
          "$msg": {
            ".write": true,
            ".validate": "!newData.exists() || (newData.child('from').isString() && newData.child('type').isString() && (!newData.child('sdp').exists() || newData.child('sdp').val().length < 20000) && (!newData.child('c').exists() || newData.child('c').val().length < 2000))"
          }
        }
      }
    }
  }
}
